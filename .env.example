# ===========================================
# DOCKER OPTIONS
# ===========================================
# Admin user created on Docker startup:
SEED_ADMIN_EMAIL=admin@admin.com
SEED_ADMIN_PASSWORD=Admin123

# Auto-grant Pro subscription (skip Stripe for local dev):
AUTO_PRO_SUBSCRIPTION=true

# Redis setup
USE_LOCAL_REDIS=true
REDIS_URL=redis://localhost:6379

# For cloud deployments, use Upstash instead:
# USE_LOCAL_REDIS=false
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ===========================================
# STRIPE
# ===========================================
# Server-side keys (never expose to browser)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Client-side publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Credit bundle Price IDs — create these as one-time prices in your Stripe dashboard
# Product name suggestion: "Credits"  |  Pricing model: Standard  |  Type: One time
NEXT_PUBLIC_STRIPE_CREDITS_STARTER=price_...    # $9
NEXT_PUBLIC_STRIPE_CREDITS_STANDARD=price_...   # $19
NEXT_PUBLIC_STRIPE_CREDITS_PRO=price_...        # $49

# Credit amounts per bundle — change without code deployment
NEXT_PUBLIC_CREDITS_STARTER_AMOUNT=50
NEXT_PUBLIC_CREDITS_STANDARD_AMOUNT=150
NEXT_PUBLIC_CREDITS_PRO_AMOUNT=500

# Legacy subscription price ID (kept for backward compat, not used in credits model)
# NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...

# ===========================================
# POSTHOG (Optional - Product Analytics)
# ===========================================
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional server-side alias for PostHog LLM analytics. Falls back to NEXT_PUBLIC_POSTHOG_KEY.
# POSTHOG_PROJECT_API_KEY=phc_...
# Set to true to disable PostHog LLM analytics without disabling product analytics.
POSTHOG_LLM_ANALYTICS_DISABLED=false
